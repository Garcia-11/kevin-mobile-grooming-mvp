# Configure hosted values through Sites runtime settings.
# For local development copy these keys into .dev.vars (never commit secrets).
OWNER_EMAIL=seedy@sites.test
DEMO_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Leave d1 until the Supabase migration and account checks succeed.
BOOKING_BACKEND=d1
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional booking confirmations/cancellations. API key is different from SMTP.
# Keep the API key server-only, marked secret in Sites. Never NEXT_PUBLIC_.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BOOKING_SITE_URL=https://your-published-site.example
